<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Registration layout connected to CreateAccountController. -->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.bowlbuddyproto.bowlbuddyproto.controller.CreateAccountController"
            prefWidth="1200"
            prefHeight="800"
            style="-fx-background-color: #FAF5E9;">

    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <Label text="BowlBuddy"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #284D3B;"/>
        </HBox>
    </top>

    <center>
        <!-- Allow scrolling when the window is too short for the form. -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="20"
                      style="-fx-background-color: #FAF5E9;">
                    <padding>
                        <Insets top="20" right="48" bottom="40" left="48"/>
                    </padding>

                    <Label text="Create Account"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #284D3B;"/>

                    <VBox spacing="10" maxWidth="400">

                        <!-- Account information stored in the User model. -->
                        <Label text="First Name"/>
                        <TextField fx:id="firstNameField"/>

                        <Label text="Last Name"/>
                        <TextField fx:id="lastNameField"/>

                        <Label text="Email"/>
                        <TextField fx:id="emailField"
                                   promptText="name@example.com"/>

                        <Label text="Username"/>
                        <TextField fx:id="usernameField"/>

                        <!-- PasswordField masks entered characters. -->
                        <Label text="Password"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="At least 8 characters"/>

                        <Label text="Confirm Password"/>
                        <PasswordField fx:id="confirmPasswordField"/>

                        <!-- Actions will be connected after adding the controller. -->
                        <!-- Validate the form and register the account through DataManager. -->
                        <Button text="Create Account"
                                onAction="#handleCreateAccount"
                                maxWidth="Infinity"
                                style="-fx-background-color: #337AB7; -fx-text-fill: white; -fx-font-size: 16px;"/>

                        <!-- Return to log in without submitting the registration form. -->
                        <Button text="Back to Sign In"
                                onAction="#handleBackToLogin"
                                maxWidth="Infinity"/>

                        <!-- Displays validation errors and registration feedback. -->
                        <Label fx:id="messageLabel"
                               wrapText="true"
                               style="-fx-text-fill: #B42318;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>