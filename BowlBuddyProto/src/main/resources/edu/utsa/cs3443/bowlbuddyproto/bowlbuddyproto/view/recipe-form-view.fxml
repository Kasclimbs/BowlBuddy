<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Add a new recipe or edit the recipe selected in the library. -->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.bowlbuddyproto.bowlbuddyproto.controller.RecipeFormController"
            prefWidth="1200" prefHeight="800"
            style="-fx-background-color: #FAF5E9;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <Label text="BowlBuddy"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #284D3B;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="16"
                      style="-fx-background-color: #FAF5E9;">
                    <padding>
                        <Insets top="20" right="48" bottom="40" left="48"/>
                    </padding>

                    <!-- RecipeFormController changes this title when editing. -->
                    <Label fx:id="titleLabel"
                           text="Add Recipe"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #284D3B;"/>

                    <VBox spacing="8" maxWidth="500">
                        <Label text="Recipe Name"/>
                        <TextField fx:id="nameField"/>

                        <Label text="Brand"/>
                        <TextField fx:id="brandField"
                                   promptText="Purina Pro Plan, Homemade..."/>

                        <Label text="Calories per 100 g"/>
                        <TextField fx:id="caloriesField"/>

                        <Label text="Tags (optional)"/>
                        <TextField fx:id="tagField"
                                   promptText="Dog, dry food"/>

                        <CheckBox fx:id="favoriteCheckBox" text="Favorite"/>

                        <Label text="Instructions (optional)"/>
                        <TextArea fx:id="instructionsField"
                                  prefRowCount="4"
                                  wrapText="true"/>

                        <HBox spacing="12">
                            <!-- Save the recipe using RecipeFormController. -->
                            <Button text="Save Recipe"
                                    onAction="#handleSaveRecipe"
                                    style="-fx-background-color: #337AB7; -fx-text-fill: white; -fx-font-size: 16px;"/>

                            <!-- Return to the recipe library without saving. -->
                            <Button text="Cancel"
                                    onAction="#handleCancel"/>
                        </HBox>

                        <Label fx:id="messageLabel"
                               wrapText="true"
                               style="-fx-text-fill: #B42318;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
